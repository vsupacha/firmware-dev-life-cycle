{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firmware-dev-life-cycle:requirements-handoff:0.3",
  "title": "Requirement to Design handoff",
  "type": "object",
  "required": ["contract_version", "phase", "handoff_status", "consumer", "consumer_acceptance", "project_id", "project_name", "baseline_id", "revision", "created_at_utc", "board_id", "constraints", "stories", "capability_snapshot", "source_freshness", "readiness", "design_checks"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "0.3"},
    "phase": {"const": "requirement"},
    "handoff_status": {"const": "offered"},
    "consumer": {"const": "design"},
    "consumer_acceptance": {"const": "pending"},
    "project_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "board_id": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "revision", "title", "role", "want", "benefit", "acceptance_criteria", "open_questions", "feasibility", "feasibility_reason", "capability_refs", "reviewed", "source_turn_ids", "origin", "next_ac_number"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^US-[0-9]+$"},
          "revision": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "want": {"type": "string", "minLength": 1},
          "benefit": {"type": "string", "minLength": 1},
          "acceptance_criteria": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "text", "test_intent", "requires_hardware"],
              "properties": {
                "id": {"type": "string", "pattern": "^US-[0-9]+-AC-[0-9]+$"},
                "text": {"type": "string", "minLength": 1},
                "test_intent": {"type": "string", "minLength": 1},
                "requires_hardware": {"type": "boolean"}
              }
            }
          },
          "open_questions": {"type": "array", "maxItems": 0},
          "feasibility": {"const": "supported"},
          "feasibility_reason": {"type": "string", "minLength": 1},
          "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reviewed": {"const": true},
          "source_turn_ids": {"type": "array", "items": {"type": "string"}},
          "origin": {"enum": ["manual", "llm_proposal"]},
          "next_ac_number": {"type": "integer", "minimum": 1}
        }
      }
    },
    "capability_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "captured_at_utc", "fingerprint", "provider_revision"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^CAP-"},
        "captured_at_utc": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_revision": {"type": ["string", "null"]}
      }
    },
    "source_freshness": {
      "type": "object",
      "required": ["status", "checked_at_utc", "changed", "added", "removed"],
      "properties": {
        "status": {"enum": ["current", "unavailable"]},
        "checked_at_utc": {"type": "string"},
        "changed": {"type": "array", "maxItems": 0},
        "added": {"type": "array", "maxItems": 0},
        "removed": {"type": "array", "maxItems": 0},
        "provider_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "readiness": {"const": "not_probed"},
    "design_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
